# LuxuryForm Studio v1 — Phase 1
#
# HOW TO USE THIS FILE (Windows):
#   1. In this folder, run:   copy .env.example .env
#   2. Open the new .env file in Notepad.
#   3. Paste your real keys after the = signs below. No quotes, no spaces.
#   4. Save and close. NEVER share .env or commit it to git.
#
# The platform starts without keys, but every provider call will report
# "not configured" until the matching key is pasted here.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
# Optional: override the Kimi API endpoint (default comes from
# config/council.yaml -> endpoints.kimi = https://api.moonshot.ai/v1).
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Optional: where the SQLite database lives (default ./data/luxuryform.db).
# LUXURYFORM_DB=./data/luxuryform.db

# Optional: provider call tuning (ADR-023 — for slow/unreliable connections).
# Per-attempt HTTP timeout in seconds (default 300), attempts per call
# (default 3, retries only timeouts/connection errors), backoff base in
# seconds between attempts (default 10; waits are base, base*3, ...).
# LUXURYFORM_PROVIDER_TIMEOUT_S=300
# LUXURYFORM_PROVIDER_MAX_ATTEMPTS=3
# LUXURYFORM_PROVIDER_BACKOFF_BASE_S=10
