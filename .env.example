# LuxuryForm Studio v1 — Phase 1
#
# HOW TO USE THIS FILE (Windows):
#   1. In this folder, run:   copy .env.example .env
#   2. Open the new .env file in Notepad.
#   3. Paste your real keys after the = signs below. No quotes, no spaces.
#   4. Save and close. NEVER share .env or commit it to git.
#
# The platform starts without keys, but every provider call will report
# "not configured" until the matching key is pasted here.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=

# Optional: where the SQLite database lives (default ./data/luxuryform.db).
# LUXURYFORM_DB=./data/luxuryform.db
